/* ==========================================================
   ECOMARKET - HOJA DE ESTILOS PRINCIPAL
   Parte 1: variables, base, cabecera, hero, tarjetas,
            beneficios, llamado a la acción y footer.
   (Las partes 2, 3 y 4 añadirán secciones al final de este
    mismo archivo: catálogo, nosotros y contacto.)
   Enfoque Mobile First: los estilos base son para móvil y
   los media queries amplían el diseño hacia pantallas mayores.
   ========================================================== */

/* ---------- 1. VARIABLES ---------- */
:root {
  /* Colores */
  --verde: #2ecc71;
  --verde-oscuro: #27ae60;
  --verde-profundo: #14452f;   /* textos y encabezados */
  --beige: #f5f5dc;
  --blanco: #ffffff;
  --gris: #5f6b64;             /* texto secundario */
  --gris-borde: #dcdfd3;

  /* Espaciado */
  --esp-1: 0.5rem;
  --esp-2: 1rem;
  --esp-3: 1.5rem;
  --esp-4: 3rem;
  --esp-5: 5rem;

  /* Radios y sombras */
  --radio: 14px;
  --radio-pill: 999px;
  --sombra: 0 2px 10px rgba(20, 69, 47, 0.08);
  --sombra-hover: 0 12px 28px rgba(20, 69, 47, 0.18);

  /* Tipografía (fuentes del sistema, sin dependencias externas) */
  --fuente-texto: "Segoe UI", system-ui, -apple-system, Roboto, "Helvetica Neue", Arial, sans-serif;
  --fuente-titulo: Georgia, "Times New Roman", serif;

  --transicion: 0.25s ease;
}

/* ---------- 2. BASE ---------- */
*, *::before, *::after { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  font-family: var(--fuente-texto);
  line-height: 1.6;
  color: var(--verde-profundo);
  background: var(--blanco);
}

img { display: block; max-width: 100%; height: auto; }

h1, h2, h3 {
  font-family: var(--fuente-titulo);
  line-height: 1.2;
  margin: 0 0 var(--esp-2);
}
h1 { font-size: clamp(2rem, 6vw, 3.4rem); }
h2 { font-size: clamp(1.5rem, 4vw, 2.2rem); }
h3 { font-size: 1.15rem; }
p  { margin: 0 0 var(--esp-2); }

a { color: var(--verde-oscuro); }

/* Foco visible para navegación con teclado */
a:focus-visible, button:focus-visible, summary:focus-visible,
input:focus-visible, label:focus-visible {
  outline: 3px solid var(--verde-profundo);
  outline-offset: 3px;
}

/* Utilidades */
.contenedor { width: min(1160px, 100% - 2rem); margin-inline: auto; }
.seccion { padding-block: var(--esp-4); }
.seccion--beige { background: var(--beige); }
.seccion__intro { max-width: 60ch; color: var(--gris); margin-bottom: var(--esp-3); }
.visually-hidden {
  position: absolute; width: 1px; height: 1px; overflow: hidden;
  clip: rect(0 0 0 0); white-space: nowrap;
}

/* ---------- 3. BOTONES ---------- */
.btn {
  display: inline-block;
  padding: 0.75rem 1.5rem;
  border: 2px solid var(--verde-oscuro);
  border-radius: var(--radio-pill);
  background: var(--verde-oscuro);
  color: var(--blanco);
  font: inherit;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  transition: background var(--transicion), transform var(--transicion), box-shadow var(--transicion);
}
.btn:hover { background: var(--verde-profundo); border-color: var(--verde-profundo); transform: translateY(-2px); box-shadow: var(--sombra); }
.btn:active { transform: translateY(0); }
.btn--claro { background: var(--blanco); color: var(--verde-profundo); border-color: var(--blanco); }
.btn--claro:hover { background: var(--beige); border-color: var(--beige); }
.btn--borde { background: transparent; color: var(--verde-oscuro); }
.btn--borde:hover { color: var(--blanco); }

/* ---------- 4. CABECERA Y NAVEGACIÓN ---------- */
.cabecera {
  position: sticky; top: 0; z-index: 50;
  background: var(--blanco);
  border-bottom: 1px solid var(--gris-borde);
}
.cabecera__barra {
  display: flex; align-items: center; justify-content: space-between;
  gap: var(--esp-2); min-height: 64px;
}
.logo {
  font-family: var(--fuente-titulo); font-size: 1.4rem; font-weight: 700;
  color: var(--verde-profundo); text-decoration: none;
}
.logo span { color: var(--verde-oscuro); }

/* Menú móvil con checkbox oculto (sin JavaScript) */
.menu-check { position: absolute; opacity: 0; pointer-events: none; }
.menu-boton {
  order: 3; cursor: pointer; font-size: 1.6rem; line-height: 1;
  padding: 0.25rem 0.6rem; border: 1px solid var(--gris-borde); border-radius: var(--radio);
}
.menu-check:focus-visible + .menu-boton { outline: 3px solid var(--verde-profundo); outline-offset: 3px; }

.menu {
  display: none; /* oculto en móvil hasta marcar el checkbox */
  position: absolute; top: 100%; left: 0; right: 0;
  background: var(--blanco); border-bottom: 1px solid var(--gris-borde);
  padding: var(--esp-2);
}
.menu-check:checked ~ .menu { display: block; }
.menu__lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.25rem; }
.menu__enlace {
  display: block; padding: 0.7rem 1rem; border-radius: var(--radio);
  color: var(--verde-profundo); text-decoration: none; font-weight: 600;
  transition: background var(--transicion);
}
.menu__enlace:hover, .menu__enlace[aria-current="page"] { background: var(--beige); }

.acciones { display: flex; gap: 0.5rem; margin-left: auto; }
.acciones__item {
  display: grid; place-items: center; width: 42px; height: 42px;
  border-radius: 50%; background: var(--beige); text-decoration: none; font-size: 1.15rem;
  transition: transform var(--transicion), background var(--transicion);
}
.acciones__item:hover { transform: scale(1.08); background: var(--verde); }

/* ---------- 5. HERO ---------- */
.hero {
  position: relative; display: grid; align-items: center;
  min-height: 78vh; color: var(--blanco);
  background-color: var(--verde-profundo); /* respaldo si la imagen no carga */
  background-image:
    linear-gradient(90deg, rgba(10, 40, 26, 0.82) 0%, rgba(10, 40, 26, 0.35) 100%),
    url("https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?auto=format&fit=crop&w=1600&q=70");
  background-size: cover; background-position: center;
}
.hero__contenido { max-width: 640px; padding-block: var(--esp-5); }
.hero__subtitulo { font-size: 1.1rem; margin-bottom: var(--esp-3); }

/* ---------- 6. TARJETAS DE PRODUCTO (inicio) ---------- */
.grid-productos { display: grid; gap: var(--esp-3); grid-template-columns: 1fr; }
.tarjeta {
  display: flex; flex-direction: column; overflow: hidden;
  background: var(--blanco); border: 1px solid var(--gris-borde);
  border-radius: var(--radio); box-shadow: var(--sombra);
  transition: transform var(--transicion), box-shadow var(--transicion);
}
.tarjeta:hover, .tarjeta:focus-within { transform: translateY(-6px); box-shadow: var(--sombra-hover); }
.tarjeta__imagen { aspect-ratio: 4 / 3; width: 100%; object-fit: cover; background: var(--beige); }
.tarjeta__cuerpo { display: flex; flex-direction: column; flex: 1; padding: var(--esp-2); }
.tarjeta__texto { color: var(--gris); font-size: 0.95rem; }
.tarjeta__pie {
  display: flex; align-items: center; justify-content: space-between;
  gap: var(--esp-1); margin-top: auto; padding-top: var(--esp-1);
}
.precio { font-weight: 700; font-size: 1.1rem; color: var(--verde-oscuro); }

/* ---------- 7. BENEFICIOS ---------- */
.grid-beneficios { display: grid; gap: var(--esp-3); grid-template-columns: 1fr; list-style: none; margin: 0; padding: 0; }
.beneficio { padding: var(--esp-3); border-left: 4px solid var(--verde); background: var(--blanco); border-radius: var(--radio); box-shadow: var(--sombra); }
.beneficio__icono { font-size: 2rem; display: block; margin-bottom: var(--esp-1); }

/* ---------- 8. LLAMADO A LA ACCIÓN ---------- */
.cta {
  text-align: center; color: var(--blanco);
  background: linear-gradient(135deg, var(--verde-profundo), var(--verde-oscuro));
}
.cta p { max-width: 55ch; margin-inline: auto; margin-bottom: var(--esp-3); }

/* ---------- 9. FOOTER ---------- */
.pie { background: var(--verde-profundo); color: var(--beige); padding-top: var(--esp-4); }
.pie a { color: var(--beige); text-decoration: none; }
.pie a:hover { text-decoration: underline; color: var(--verde); }
.pie__grid { display: grid; gap: var(--esp-3); grid-template-columns: 1fr; }
.pie h2 { font-size: 1.1rem; color: var(--blanco); }
.pie ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
.pie__legal {
  margin-top: var(--esp-4); padding-block: var(--esp-2);
  border-top: 1px solid rgba(245, 245, 220, 0.25); font-size: 0.9rem;
}

/* ---------- 10. MEDIA QUERIES ---------- */
@media (min-width: 600px) {
  .grid-productos { grid-template-columns: repeat(2, 1fr); }
  .grid-beneficios { grid-template-columns: repeat(2, 1fr); }
  .pie__grid { grid-template-columns: repeat(2, 1fr); }
}

@media (min-width: 900px) {
  /* Se oculta el botón hamburguesa y el menú pasa a ser horizontal */
  .menu-boton { display: none; }
  .menu { display: block; position: static; border: 0; padding: 0; margin-left: auto; }
  .menu__lista { display: flex; gap: 0.25rem; }
  .acciones { margin-left: var(--esp-2); }
  .grid-productos { grid-template-columns: repeat(3, 1fr); }
  .grid-beneficios { grid-template-columns: repeat(4, 1fr); }
  .pie__grid { grid-template-columns: 2fr 1fr 1fr 1fr; }
}

/* ---------- 11. ACCESIBILIDAD: MOVIMIENTO REDUCIDO ---------- */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}